# Raiz do painel (sem barra no final)
SIGMA_PANEL_URL=https://espaceoneplay.sigmab.pro

# Credenciais de revenda usadas para logar no painel.
# NUNCA commite estes valores.
SIGMA_USER=
SIGMA_PASS=

# Token exigido pelo nosso servidor REST (qualquer string longa aleatoria).
SIGMA_SERVER_TOKEN=

# Bind do servidor
SIGMA_BIND=127.0.0.1:8787

# Timeout das chamadas ao painel (segundos)
SIGMA_TIMEOUT_SECS=120
