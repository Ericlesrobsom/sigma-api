# API oficial do painel Sigma (Sem barra no final)
SIGMA_API_BASE_URL=https://espaceoneplay.sigmab.pro/api/reseller-api/v1

# Token de revenda criado em Integracoes -> Reseller API.
# O plaintext aparece uma unica vez. NUNCA commite este valor.
SIGMA_API_TOKEN=

# Token exigido pelo nosso servidor REST (qualquer string longa aleatoria).
SIGMA_SERVER_TOKEN=

# Bind do servidor
SIGMA_BIND=127.0.0.1:8787

# Timeout das chamadas ao painel (segundos)
SIGMA_TIMEOUT_SECS=30
