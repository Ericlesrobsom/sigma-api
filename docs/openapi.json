{
  "openapi": "3.1.0",
  "info": {
    "title": "Sigma API Gateway (painel)",
    "version": "0.1.0",
    "description": "API REST local que loga no painel Sigma como revenda (usuário/senha + CAP)\ne expõe os dados da conta. Autentique com\n`Authorization: Bearer $SIGMA_SERVER_TOKEN`.\nAs credenciais do painel ficam somente no servidor.\n"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check publico",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Este contrato",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI JSON"
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "summary": "Perfil, creditos e permissoes da conta",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/customers": {
      "get": {
        "summary": "Lista clientes",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "username",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isTrial",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                true,
                false
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Cria cliente",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "server_id",
                  "package_id"
                ],
                "properties": {
                  "server_id": {
                    "type": "string"
                  },
                  "package_id": {
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "connections": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "trial_hours": {
                    "type": "number"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "telegram": {
                    "type": "string"
                  },
                  "whatsapp": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "plan_price": {},
                  "bouquets": {}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/v1/customers/by-username/{username}": {
      "get": {
        "summary": "Busca por username",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/customers/{id}": {
      "get": {
        "summary": "Detalhe do cliente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "summary": "Atualiza campos gravaveis (merge com o cliente atual)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "mac_address": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "telegram": {
                    "type": "string"
                  },
                  "whatsapp": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "plan_price": {},
                  "bouquets": {},
                  "playlist": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      },
      "delete": {
        "summary": "Remove o cliente (soft delete)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/customers/{id}/renew": {
      "post": {
        "summary": "Renova o cliente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "package_id": {
                    "type": "string"
                  },
                  "connections": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reference": {
                    "type": "string"
                  },
                  "create_manual_customer_order": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/v1/customers/{id}/change-package": {
      "post": {
        "summary": "Troca o plano (mesmo numero de conexoes)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "package_id"
                ],
                "properties": {
                  "package_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/v1/customers/{id}/change-connections": {
      "post": {
        "summary": "Troca o numero de conexoes",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "package_id",
                  "connections"
                ],
                "properties": {
                  "package_id": {
                    "type": "string"
                  },
                  "connections": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/v1/customers/{id}/toggle-status": {
      "put": {
        "summary": "Alterna Ativo/Inativo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/customers/{id}/courtesy-days": {
      "post": {
        "summary": "Adiciona 3 dias de cortesia (vence em ate 3 dias)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/v1/customers/{id}/server-migration": {
      "put": {
        "summary": "Migra o cliente para outro servidor/plano",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "server_id",
                  "package_id"
                ],
                "properties": {
                  "server_id": {
                    "type": "string"
                  },
                  "package_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/v1/customers/{id}/asn-lock": {
      "put": {
        "summary": "Alterna a trava ASN",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/customers/{id}/isp-lock": {
      "put": {
        "summary": "Alterna a trava ISP",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/packages": {
      "get": {
        "summary": "Planos/pacotes",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/servers": {
      "get": {
        "summary": "Servidores",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/credit-orders": {
      "get": {
        "summary": "Pedidos de credito",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/credit-transactions": {
      "get": {
        "summary": "Extrato de creditos",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/credit-summary": {
      "get": {
        "summary": "Resumo do extrato",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/resellers": {
      "get": {
        "summary": "Revendas da conta",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      },
      "post": {
        "summary": "Cria revenda",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password",
                  "credits"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "credits": {
                    "type": "number",
                    "minimum": 10
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "telegram": {
                    "type": "string"
                  },
                  "whatsapp": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "reseller",
                      "master_reseller",
                      "reseller_pos"
                    ]
                  },
                  "servers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/v1/resellers/{id}/credits": {
      "post": {
        "summary": "Adiciona creditos a revenda",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "credits"
                ],
                "properties": {
                  "credits": {
                    "type": "number",
                    "minimum": 0.001
                  },
                  "reference": {
                    "type": "string"
                  },
                  "private_note": {
                    "type": "string"
                  },
                  "create_manual_credit_order": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/v1/resellers/{id}": {
      "get": {
        "summary": "Mostra uma revenda",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "summary": "Atualiza campos gravaveis da revenda (merge)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "telegram": {
                    "type": "string"
                  },
                  "whatsapp": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "servers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "disable_after_days_without_recharge": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      },
      "delete": {
        "summary": "Exclui a revenda",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/resellers/{id}/credits/remove": {
      "post": {
        "summary": "Remove creditos da revenda",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "credits"
                ],
                "properties": {
                  "credits": {
                    "type": "number",
                    "minimum": 0.001
                  },
                  "reference": {
                    "type": "string"
                  },
                  "private_note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/resellers/{id}/toggle-status": {
      "put": {
        "summary": "Alterna Ativo/Inativo da revenda",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/customers-count": {
      "get": {
        "summary": "Contagem de clientes",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/customers-count-by-server": {
      "get": {
        "summary": "Contagem de clientes por servidor",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/expiring": {
      "get": {
        "summary": "Clientes a vencer",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    },
    "/v1/notices": {
      "get": {
        "summary": "Avisos do painel",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Envelope"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "Envelope": {
        "description": "Resposta do painel",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean"
                },
                "data": {}
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token local ausente/invalido",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Nao encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Validation": {
        "description": "Validacao/estado invalido (4xx do painel)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
